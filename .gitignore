*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Código generado por build_runner (drift). Se regenera con:
#   dart run build_runner build
*.g.dart

# Salidas de cobertura
/coverage/

# Borradores de contenido en curso; solo se versiona el validador
/scratchpad/content/*.json

# Guías personales: viven en /private y solo tool/personal.sh las copia a
# assets/private/ mientras dura el build. Nunca en el repo público.
/private/
assets/private/*
!assets/private/README.md

# Contexto personal y de herramientas de IA (vive en personal_context/)
CLAUDE.md
CLAUDE.local.md
.claude/
